<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\Api\ProductRepositoryInterface">
        <plugin name="brocode_keep_composite_stock_automatic"
                type="BroCode\CompositeStockStatus\Plugin\KeepCompositeStockAutomatic"/>
    </type>
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="brocodeCompositeStockRevive" xsi:type="object">
                    BroCode\CompositeStockStatus\Console\Command\ReviveCompositeStockCommand
                </item>
            </argument>
        </arguments>
    </type>
    <!--
        Console commands are constructed when the CLI builds its command list,
        which includes during setup:install. Without proxies this command's
        service graph is built against a database that does not have a default
        website yet, and the installer dies in Session\Config.
    -->
    <type name="BroCode\CompositeStockStatus\Console\Command\ReviveCompositeStockCommand">
        <arguments>
            <argument name="parentStockReviver" xsi:type="object">
                BroCode\CompositeStockStatus\Model\ParentStockReviver\Proxy
            </argument>
            <argument name="appState" xsi:type="object">Magento\Framework\App\State\Proxy</argument>
        </arguments>
    </type>

    <!--
        Multi-source: two defects compound into a configurable that is unsalable
        in every stock. See docs/mechanism.md.
    -->
    <type name="Magento\InventoryConfigurableProductIndexer\Indexer\SelectBuilder">
        <plugin name="brocode_use_stock_scoped_salability"
                type="BroCode\CompositeStockStatus\Plugin\UseStockScopedSalability"/>
    </type>
    <type name="Magento\InventoryGroupedProductIndexer\Indexer\SelectBuilder">
        <plugin name="brocode_use_stock_scoped_salability_grouped"
                type="BroCode\CompositeStockStatus\Plugin\UseStockScopedSalability"/>
    </type>
    <type name="Magento\InventoryBundleProductIndexer\Indexer\SelectBuilder">
        <plugin name="brocode_use_stock_scoped_salability_bundle"
                type="BroCode\CompositeStockStatus\Plugin\UseStockScopedSalability"/>
    </type>
    <type name="Magento\InventoryApi\Api\SourceItemsSaveInterface">
        <plugin name="brocode_recompose_composite_stock_in_multi_source"
                type="BroCode\CompositeStockStatus\Plugin\RecomposeCompositeStockInMultiSource"/>
    </type>
</config>
